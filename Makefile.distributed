# RustInfer Makefile - Distributed mode targets

.PHONY: help build build-release run-distributed clean

help:
	@echo "RustInfer Distributed Mode - Make Commands"
	@echo ""
	@echo "Build:"
	@echo "  make build              Build debug binaries"
	@echo "  make build-release      Build release binaries (optimized)"
	@echo ""
	@echo "Run:"
	@echo "  make run-distributed MODEL=<path> [DEVICE=cuda:0] [PORT=8000]"
	@echo "                          Start all processes (automatic cleanup on Ctrl+C)"
	@echo "  make show-manual        Show manual startup commands"
	@echo ""
	@echo "Cleanup:"
	@echo "  make clean              Remove debug artifacts"
	@echo "  make clean-ipc          Clean up stale IPC files"
	@echo ""

# Build targets
build:
	@echo "Building RustInfer (debug)..."
	cargo build --bin rustinfer-server --bin rustinfer-api

build-release:
	@echo "Building RustInfer (release)..."
	cargo build --release --bin rustinfer-server --bin rustinfer-api

# Run targets
run-distributed:
	@if [ -z "$(MODEL)" ]; then \
		echo "Error: MODEL is required. Usage: make run-distributed MODEL=<path>"; \
		exit 1; \
	fi
	@scripts/start_distributed.sh \
		--model "$(MODEL)" \
		--device "$(DEVICE)" \
		--port "$(PORT)" \
		--log-level "$(LOG_LEVEL)"

show-manual:
	@bash scripts/manual_startup.sh

# Cleanup targets
clean:
	@echo "Cleaning build artifacts..."
	cargo clean

clean-ipc:
	@echo "Cleaning up IPC files..."
	@rm -f /tmp/rustinfer-*.ipc
	@echo "Done"

# Install to system PATH (optional)
install-release: build-release
	@echo "Installing binaries to ~/.cargo/bin ..."
	@cargo install --path crates/infer-server --release --bin rustinfer-server
	@cargo install --path crates/infer-server --release --bin rustinfer-api
	@echo "Binaries installed. Make sure ~/.cargo/bin is in your PATH"
